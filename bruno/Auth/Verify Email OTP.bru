meta {
  name: Verify Email OTP
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/auth/email-otp/verify
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "shopId": "{{shopId}}",
    "code": "{{otpCode}}"
  }
}

docs {
  Disabled. Always returns 410 EMAIL_OTP_DISABLED. `code` must still be 4 digits or validation fails first.
}
