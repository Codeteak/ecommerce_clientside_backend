meta {
  name: Request Phone OTP
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/otp/request
  body: json
  auth: none
}

body:json {
  {
    "phone": "{{phone}}",
    "shopId": "{{shopId}}"
  }
}

docs {
  Sends a 4-digit OTP. `phone` accepts +91, 91, or a 10-digit number. `shopId` must be a UUID. Rate limit is 8 requests per 15 minutes in production.
}
